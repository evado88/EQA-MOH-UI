# Frontend build-time configuration (Vite).
#
# These values are baked into the build by `npm run build`, so they must be set
# BEFORE building for the server. On the VPS, copy this file to
# .env.production.local (git-ignored) and fill in the real values.
# Every variable must start with VITE_ to be exposed to the app.
# Keep the trailing slash on the URLs.
#
# Single-domain setup: the API is served under /api/ on the same host as the
# app, so the base URL is the site URL + /api/.

# Public base URL of the FastAPI backend — where the built app sends every
# request. For https://eqa.ims-zm.online/ the API base is:
VITE_API_URL=https://eqa.ims-zm.online/api/

# Reports base URL. Same as the API for now (XtraReports is deployed later).
VITE_REPORT_URL=https://eqa.ims-zm.online/api/

# Optional secondary API base; set to the API URL unless you specifically use it.
VITE_LOCAL_API_URL=https://eqa.ims-zm.online/api/

# "true" shows the admin "Dev: Jump to Phase" card (useful for the validation
# workshop). Set to "false" (or omit) to hide it for real production.
VITE_ENABLE_DEV_TOOLS=false
