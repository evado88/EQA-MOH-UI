# Local development (vite dev). The API base URLs fall back to localhost in
# code, so these mainly document the dev setup and switch on the dev tools.
VITE_API_URL=http://127.0.0.1:8800/
VITE_REPORT_URL=http://127.0.0.1:8800/
VITE_LOCAL_API_URL=http://127.0.0.1:8700/

# shows the admin "Dev: Jump to Phase" card during local development
VITE_ENABLE_DEV_TOOLS=true
